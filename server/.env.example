# Server Port (automatically set by Railway, defaults to 3000 locally)
PORT=3000
NODE_ENV=production

# Frontend URL (comma-separated if multiple, e.g. Vercel deployment URL)
FRONTEND_URL=https://your-quizcore-frontend.vercel.app

# Supabase PostgreSQL Database URL
DATABASE_URL="postgresql://postgres:QuizCore7.vercel.app@db.zzkxdsgbaxihilsizqzg.supabase.co:5432/postgres"

# JWT Secret for organizer authentication
JWT_SECRET=supersecret_jwt_key_here

# Default Admin Organizer Credentials (auto-seeded on server startup)
ADMIN_EMAIL=admin@quizcore.com
ADMIN_PASSWORD=password123
ADMIN_NAME=Admin Organizer

